* text=auto
*.py text eol=lf
*.cs text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
# Unity escribe campos YAML vacíos con un espacio final.
*.unity text eol=lf whitespace=-blank-at-eol
*.prefab text eol=lf whitespace=-blank-at-eol
*.mat text eol=lf whitespace=-blank-at-eol
*.meta text eol=lf whitespace=-blank-at-eol
*.asset text=auto whitespace=-blank-at-eol
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.png binary
*.jpg binary
*.webp binary
*.xlsx binary
